# Optional frontend API base URL.
# Leave empty for default behavior:
# - npm run dev: http://<host>:3001/api
# - npm run build: /api through reverse proxy
#
# VPS/staging/production must use /api. Never use http://localhost:3001/api
# or http://<server-ip>:3001/api for public builds.
#
# VITE_API_URL=/api
