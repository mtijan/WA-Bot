# Backend listener
PORT=3001
WA_BOT_LOG_LEVEL=info

# Optional for local development, required before public network exposure.
WA_BOT_API_KEY=replace-with-a-long-random-secret

# Admin dashboard login. Required before public network exposure.
WA_BOT_ADMIN_USERNAME=admin
WA_BOT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Required; use a dedicated random value of at least 32 characters.
WA_BOT_ADMIN_SESSION_SECRET=replace-with-a-long-random-cookie-signing-secret
WA_BOT_ADMIN_SESSION_TTL_MS=43200000
# Set true only when serving over HTTPS.
# WA_BOT_COOKIE_SECURE=true

# Comma-separated browser origins allowed to call the API.
WA_BOT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# In-memory API rate limiter defaults.
WA_BOT_RATE_LIMIT_WINDOW_MS=60000
WA_BOT_RATE_LIMIT_MAX=120

# Request-size policy. Keep the default small; imports get a separate larger limit.
WA_BOT_JSON_BODY_LIMIT=2mb
WA_BOT_IMPORT_BODY_LIMIT=60mb
# Optional Content-Security-Policy frame-ancestors value.
# WA_BOT_FRAME_ANCESTORS='none'

# Required (minimum 32 characters). Encrypts Baileys session files and newly saved Chatbot AI provider keys.
WA_BOT_SECRET_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# Optional IPLocate API key for proxy testing/offline IP database download.
# Prefer this env var over storing the key in SQLite settings for production.
# WA_BOT_IPLOCATE_API_KEY=replace-with-iplocate-api-key

# Media upload limits for admin-created message assets.
# Defaults: images 5MB, videos 10MB.
# WA_BOT_MEDIA_UPLOAD_DIR=/opt/wa-bot/backend/uploads/media
# WA_BOT_IMAGE_UPLOAD_MAX_BYTES=5242880
# WA_BOT_VIDEO_UPLOAD_MAX_BYTES=10485760

# Optional external alerting. Keep webhook URLs secret and outside frontend JavaScript.
# WA_BOT_ALERT_WEBHOOK_URL=https://example.invalid/webhook
# WA_BOT_ALERT_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# WA_BOT_ALERT_TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
# WA_BOT_ALERT_PUBLIC_URL=https://stagingwabot.web.id/
# WA_BOT_ALERT_PUBLIC_HEALTH_URL=https://stagingwabot.web.id/health
# WA_BOT_ALERT_BACKUP_MAX_AGE_HOURS=36
# WA_BOT_ALERT_DISK_WARN_PERCENT=80

# Delivery log retention used by npm run logs:prune.
WA_BOT_LOG_RETENTION_DAYS=30

# Optional backup target. Store backups on encrypted protected storage.
# WA_BOT_BACKUP_DIR=D:\secure-backups\wa-bot
# Required for encrypted runtime backups and restore drills.
# Keep this secret outside the backup destination.
# WA_BOT_BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-secret
# Optional encrypted backup and restore drill targets.
# WA_BOT_ENCRYPTED_BACKUP_DIR=D:\secure-backups\wa-bot-encrypted
# WA_BOT_RESTORE_DRILL_DIR=D:\restore-drills\wa-bot

# Set only when Express is behind a trusted reverse proxy.
# WA_BOT_TRUST_PROXY_HOPS=1

# Runtime process split. Defaults to all (local monolith).
# WA_BOT_PROCESS_ROLE=all
# WA_BOT_PROCESS_HEARTBEAT_MS=60000
# WA_BOT_CAMPAIGN_WORKER_POLL_MS=15000
# WA_BOT_WARMER_WORKER_POLL_MS=30000

# Internal process control API for session-manager split.
# Use a long random token and keep this API bound to localhost/private network.
# WA_BOT_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
# WA_BOT_INTERNAL_PORT=3002
# WA_BOT_SESSION_MANAGER_URL=http://127.0.0.1:3002/internal
