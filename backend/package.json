{
  "name": "wa-bot-backend",
  "version": "1.0.0",
  "description": "WhatsApp Bot Multi-Account & Bulk Messaging System Backend",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:api": "node src/processes/api.js",
    "start:sessions": "node src/processes/sessions.js",
    "start:campaign-worker": "node src/processes/campaign_worker.js",
    "start:warmer-worker": "node src/processes/warmer_worker.js",
    "start:worker": "node src/processes/worker.js",
    "dev": "node src/index.js",
    "db:migrate": "node scripts/migrate_database.js",
    "db:migrate:no-backup": "node scripts/migrate_database.js --no-backup",
    "backup": "node scripts/backup_runtime_data.js",
    "backup:encrypted": "node scripts/backup_runtime_data_encrypted.js",
    "restore:drill": "node scripts/restore_drill_encrypted_backup.js",
    "security:audit": "npm audit --omit=dev",
    "monitor:alert": "node scripts/alert_healthcheck.js",
    "sessions:repair-auto": "node scripts/auto_repair_disconnected.js",
    "logs:prune": "node scripts/prune_delivery_logs.js",
    "logs:prune:apply": "node scripts/prune_delivery_logs.js --apply",
    "test": "node --test test/**/*.test.js",
    "test:smoke": "node scripts/deploy_smoke_test.js",
    "test:ai-provider": "node scripts/probe_chatbot_ai_provider.js",
    "test:rag-development": "node scripts/probe_chatbot_ai_rag_development.js",
    "test:rag-freeform-development": "node scripts/probe_chatbot_ai_rag_development.js --conversation true --question-mode freeform --judge true --cases 12 --answer-cap 512 --judge-cap 1024 --seed 20260910",
    "test:rag-phase9": "node scripts/probe_chatbot_ai_rag_phase9.js --output ../scratch/rag_phase9_generation_report.json",
    "rag:index:once": "node scripts/process_rag_indexing.js",
    "user:create": "node scripts/seed_admin_user.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "fflate": "^0.8.3",
    "https-proxy-agent": "^9.0.0",
    "multer": "^2.2.0",
    "openai": "^6.39.1",
    "pino": "^9.1.0",
    "qrcode": "^1.5.3",
    "sqlite3": "^6.0.1",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "multer": "^2.2.0",
    "protobufjs": "^7.6.4",
    "undici": "^6.27.0"
  }
}
