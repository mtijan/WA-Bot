[Unit]
Description=WA-Bot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wa-bot
Group=wa-bot
WorkingDirectory=/opt/wa-bot/backend
EnvironmentFile=/etc/wa-bot/wa-bot.env
ExecStart=/usr/bin/node /opt/wa-bot/backend/src/processes/api.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wa-bot/backend /var/log/wa-bot
StandardOutput=append:/var/log/wa-bot/api.out.log
StandardError=append:/var/log/wa-bot/api.err.log

[Install]
WantedBy=multi-user.target
